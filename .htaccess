Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /dig_travel_and_tour/

    # Already inside /public — do nothing extra
    RewriteRule ^public/ - [L]

    # Send everything else into Laravel's public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
