Options -Indexes
DirectoryIndex index.phtml index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /dig_travel_and_tour/

    # Leave /public as-is (no double rewrite)
    RewriteRule ^public(?:/|$) - [L]

    # Send all other requests into public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
